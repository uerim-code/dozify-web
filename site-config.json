{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "accept-language",
          "value": "tr(-[A-Za-z]+)?([;,].*)?"
        }
      ],
      "destination": "/tr",
      "permanent": false
    },
    {
      "source": "/",
      "destination": "/en",
      "permanent": false
    },
    {
      "source": "/glp1-shot-tracker",
      "destination": "/en/glp1-shot-tracker",
      "permanent": true
    },
    {
      "source": "/injection-site-tracker",
      "destination": "/en/injection-site-tracker",
      "permanent": true
    },
    {
      "source": "/glp1-weight-tracker",
      "destination": "/en/glp1-weight-tracker",
      "permanent": true
    },
    {
      "source": "/glp1-side-effect-journal",
      "destination": "/en/glp1-side-effect-journal",
      "permanent": true
    },
    {
      "source": "/glp1-vial-tracker",
      "destination": "/en/glp1-vial-tracker",
      "permanent": true
    },
    {
      "source": "/private-glp1-tracker",
      "destination": "/en/private-glp1-tracker",
      "permanent": true
    },
    {
      "source": "/glp1-appointment-report",
      "destination": "/en/glp1-appointment-report",
      "permanent": true
    },
    {
      "source": "/switch-glp1-tracker-app",
      "destination": "/en/switch-glp1-tracker-app",
      "permanent": true
    },
    {
      "source": "/why",
      "destination": "/en/why",
      "permanent": true
    },
    {
      "source": "/support",
      "destination": "/en/support",
      "permanent": true
    },
    {
      "source": "/privacy",
      "destination": "/en/privacy",
      "permanent": true
    },
    {
      "source": "/terms",
      "destination": "/en/terms",
      "permanent": true
    },
    {
      "source": "/kvkk",
      "destination": "/en/kvkk",
      "permanent": true
    },
    {
      "source": "/articles",
      "destination": "/en/articles",
      "permanent": true
    },
    {
      "source": "/articles/what-is-glp1",
      "destination": "/en/articles/what-is-glp1",
      "permanent": true
    },
    {
      "source": "/articles/how-to-inject-glp1",
      "destination": "/en/articles/how-to-inject-glp1",
      "permanent": true
    },
    {
      "source": "/articles/glp1-injection-sites",
      "destination": "/en/articles/glp1-injection-sites",
      "permanent": true
    },
    {
      "source": "/articles/glp1-side-effects",
      "destination": "/en/articles/glp1-side-effects",
      "permanent": true
    },
    {
      "source": "/articles/glp1-patches",
      "destination": "/en/articles/glp1-patches",
      "permanent": true
    },
    {
      "source": "/shotsy-alternative",
      "destination": "/en/shotsy-alternative",
      "permanent": true
    },
    {
      "source": "/glapp-alternative",
      "destination": "/en/glapp-alternative",
      "permanent": true
    },
    {
      "source": "/glucopal-alternative",
      "destination": "/en/glucopal-alternative",
      "permanent": true
    },
    {
      "source": "/chembiocalc/support",
      "destination": "https://chembiocalc.com/support",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(), camera=(), microphone=(), interest-cohort=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'sha256-qdHBxvNHySbWOqiG2lX+5sAMGTbXvmLQ3aovlGZb4/U=' https://www.googletagmanager.com https://www.googleadservices.com https://googleads.g.doubleclick.net; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self'; connect-src 'self' https://www.googletagmanager.com https://www.googleadservices.com https://googleads.g.doubleclick.net https://pagead2.googlesyndication.com https://www.google.com https://www.google-analytics.com; frame-src https://td.doubleclick.net https://www.googletagmanager.com; upgrade-insecure-requests"
        }
      ]
    }
  ]
}
